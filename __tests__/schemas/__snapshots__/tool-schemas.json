{
  "apply_patch": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Required for single-file patches without a/ b/ headers; ignored for multi-file patches",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "patch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10485760,
          "description": "Unified diff patch content (unified format with --- a/ +++ b/ headers)",
          "examples": [
            "--- a/src/foo.ts\n+++ b/src/foo.ts\n@@ -1,3 +1,3 @@\n-const x = 1;\n+const x = 2;\n"
          ]
        },
        "dryRun": {
          "default": false,
          "description": "Validate patch without applying",
          "type": "boolean"
        },
        "fuzzFactor": {
          "default": 0,
          "description": "Lines of context allowed to differ (0–10)",
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "autoConvertLineEndings": {
          "default": false,
          "description": "Auto-convert line endings",
          "type": "boolean"
        }
      },
      "required": [
        "patch"
      ],
      "additionalProperties": false
    }
  },
  "calculate_hash": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Path inside an allowed root"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  "diff_files": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "original": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Original file path"
        },
        "modified": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Modified file path"
        },
        "context": {
          "description": "Context lines (default 3)",
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "ignoreWhitespace": {
          "default": false,
          "description": "Ignore whitespace changes",
          "type": "boolean"
        },
        "stripTrailingCr": {
          "default": false,
          "description": "Strip trailing carriage returns",
          "type": "boolean"
        }
      },
      "required": [
        "original",
        "modified"
      ],
      "additionalProperties": false
    }
  },
  "edit": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Path inside an allowed root"
        },
        "edits": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "oldText": {
                "type": "string",
                "minLength": 1,
                "description": "Exact text to find (must match literally)",
                "examples": [
                  "const x = 1;",
                  "function oldName("
                ]
              },
              "newText": {
                "type": "string",
                "description": "Replacement text (empty string to delete)",
                "examples": [
                  "const x = 2;",
                  "function newName(",
                  ""
                ]
              }
            },
            "required": [
              "oldText",
              "newText"
            ],
            "additionalProperties": false
          },
          "description": "List of text substitutions"
        },
        "dryRun": {
          "default": false,
          "description": "Preview changes without writing",
          "type": "boolean"
        },
        "ignoreWhitespace": {
          "default": false,
          "description": "Ignore leading/trailing whitespace when matching",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "edits"
      ],
      "additionalProperties": false
    }
  },
  "find": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Base directory (default: root)",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "pattern": {
          "description": "Glob pattern to search",
          "$ref": "#/$defs/SafeGlobPattern"
        },
        "maxResults": {
          "default": 100,
          "description": "Max files to return",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "includeIgnored": {
          "default": false,
          "description": "Include ignored items (node_modules, .git, etc).",
          "type": "boolean"
        },
        "includeHidden": {
          "default": false,
          "description": "Include hidden items (starting with .)",
          "type": "boolean"
        },
        "sortBy": {
          "default": "path",
          "description": "Sort order",
          "type": "string",
          "enum": [
            "name",
            "size",
            "modified",
            "path"
          ]
        },
        "maxDepth": {
          "description": "Max directory depth",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cursor": {
          "description": "Pagination cursor from a previous response. Treat as opaque. `ls` cursors are snapshot-backed (expire after ~5 min or restart); `find` cursors are offset-based and re-run the query each page.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "pattern"
      ],
      "additionalProperties": false,
      "$defs": {
        "SafeGlobPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Glob pattern (e.g. \"**/*.ts\", \"src/**/*.js\")",
          "title": "Glob Pattern",
          "examples": [
            "**/*.ts",
            "src/**/*.js",
            "*.{ts,tsx}"
          ]
        }
      }
    }
  },
  "grep": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Path inside an allowed root"
        },
        "pattern": {
          "description": "File glob filter (default: all text files)",
          "$ref": "#/$defs/SafeGlobPattern"
        },
        "searchPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "description": "Text or regex to search for (RE2: no lookahead/lookbehind/backrefs when isRegex=true)",
          "examples": [
            "TODO",
            "function\\s+(\\w+)",
            "import.*from"
          ]
        },
        "isRegex": {
          "default": false,
          "description": "Treat searchPattern as regex",
          "type": "boolean"
        },
        "includeHidden": {
          "default": false,
          "description": "Include hidden items (starting with .)",
          "type": "boolean"
        },
        "includeIgnored": {
          "default": false,
          "description": "Include ignored items (node_modules, .git, etc).",
          "type": "boolean"
        },
        "caseSensitive": {
          "default": false,
          "description": "Case-sensitive",
          "type": "boolean"
        },
        "wholeWord": {
          "default": false,
          "description": "Match whole words only",
          "type": "boolean"
        },
        "contextLines": {
          "description": "Lines of context before AND after each match (symmetric; overridden by contextBefore/contextAfter)",
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "contextBefore": {
          "description": "Lines of context before each match (overrides contextLines for before)",
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "contextAfter": {
          "description": "Lines of context after each match (overrides contextLines for after)",
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "fuzzy": {
          "description": "Approximate string matching (Levenshtein-based, ≤25% char difference). Incompatible with isRegex.",
          "type": "boolean"
        },
        "maxResults": {
          "default": 500,
          "description": "Max matches to return per page",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxDepth": {
          "description": "Max directory depth",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "cursor": {
          "description": "Pagination cursor from a previous response. Treat as opaque. `ls` cursors are snapshot-backed (expire after ~5 min or restart); `find` cursors are offset-based and re-run the query each page.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "searchPattern"
      ],
      "additionalProperties": false,
      "$defs": {
        "SafeGlobPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Glob pattern (e.g. \"**/*.ts\", \"src/**/*.js\")",
          "title": "Glob Pattern",
          "examples": [
            "**/*.ts",
            "src/**/*.js",
            "*.{ts,tsx}"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "pattern"
            ]
          },
          "then": {
            "properties": {
              "pattern": {
                "not": {
                  "anyOf": [
                    {
                      "pattern": "^/"
                    },
                    {
                      "pattern": "^[A-Za-z]:"
                    },
                    {
                      "pattern": "\\.\\."
                    }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "ls": {
    "inputSchema": {
      "type": "object",
