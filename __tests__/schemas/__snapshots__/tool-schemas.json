        "cursor": {
          "description": "Pagination cursor from a previous response. Treat as opaque. `ls` cursors are snapshot-backed (expire after ~5 min or restart); `find` cursors are offset-based and re-run the query each page.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$"
        }
      },
      "additionalProperties": false,
      "$defs": {
        "SafeGlobPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Glob pattern (e.g. \"**/*.ts\", \"src/**/*.js\")",
          "title": "Glob Pattern",
