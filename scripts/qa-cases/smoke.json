{
  "cases": [
    {
      "id": "SMOKE-001",
      "title": "Critical path smoke",
      "traceability": "F1, F2, F7, F8, F16, F22",
      "profile": "default",
      "steps": [
        {
          "name": "initialize",
          "method": "initialize",
          "expect": {
            "has": ["serverInfo"]
          }
        },
        {
          "name": "tools/list",
          "method": "tools/list",
          "expect": {
            "has": ["tools"]
          }
        },
        {
          "name": "list_roots",
          "method": "tools/call",
          "tool": "list_roots",
          "args": {},
          "expect": {
            "isError": false
          }
        },
        {
          "name": "list the root",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "create a scratch file",
          "method": "tools/call",
          "tool": "create",
          "args": {
            "files": [
              {
                "path": "${FIXTURE}/smoke.txt",
                "content": "smoke\n"
              }
            ]
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "read it back",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/smoke.txt"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "denied file stays denied",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/.env"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "instructions resource is readable",
          "method": "resources/read",
          "uri": "internal://instructions",
          "expect": {
            "has": ["contents"]
          }
        }
      ]
    }
  ]
}
