{
  "cases": [
    {
      "id": "TC-SEC-001",
      "title": "--read-only removes every mutating tool",
      "traceability": "F22",
      "profile": "readonly",
      "steps": [
        {
          "name": "tools/list under --read-only",
          "method": "tools/list",
          "expect": {
            "has": ["tools"]
          }
        },
        {
          "name": "create is not registered",
          "method": "tools/call",
          "tool": "create",
          "args": {
            "files": [
              {
                "path": "${FIXTURE}/nope.txt",
                "content": "x\n"
              }
            ]
          },
          "expect": {
            "cliErrorCode": "tool_not_found"
          }
        },
        {
          "name": "delete is not registered",
          "method": "tools/call",
          "tool": "delete",
          "args": {
            "paths": ["${FIXTURE}/src/ten.txt"]
          },
          "expect": {
            "cliErrorCode": "tool_not_found"
          }
        },
        {
          "name": "read still works",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt"
          },
          "expect": {
            "isError": false
          }
        }
      ]
    },
    {
      "id": "TC-SEC-002",
      "title": "Path traversal and symlink escape are denied",
      "traceability": "F23",
      "profile": "default",
      "steps": [
        {
          "name": "traversal on read",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/../outside-target.txt"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "traversal on write",
          "method": "tools/call",
          "tool": "create",
          "args": {
            "files": [
              {
                "path": "${FIXTURE}/../pwned.txt",
                "content": "no\n"
              }
            ]
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "traversal through the file resource URI",
          "method": "resources/read",
          "uri": "filesystem-mcp://file/..%2F..%2Fetc%2Fhosts",
          "expect": {
            "cliErrorCode": "error"
          }
        },
        {
          "name": "symlink escaping the root",
          "skip": "symlink creation needs elevated rights on Windows; run by hand on a POSIX host"
        }
      ]
    },
    {
      "id": "TC-SEC-003",
      "title": "Sensitive file denylist and --deny patterns",
      "traceability": "F24",
      "profile": "denied",
      "steps": [
        {
          "name": "built-in .env is denied",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/.env"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "built-in *.pem is denied",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/key.pem"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "built-in *id_rsa* is denied",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/id_rsa"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "custom --deny pattern is denied",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/notes.secret"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "writing to a denied path is refused",
          "method": "tools/call",
          "tool": "create",
          "args": {
            "files": [
              {
                "path": "${FIXTURE}/.env",
                "content": "OVERWRITTEN\n"
              }
            ]
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-SEC-003b",
      "title": "--allow-sensitive relaxes built-ins but never an explicit --deny",
      "traceability": "F24",
      "profile": "permissive",
      "steps": [
        {
          "name": ".env is readable under --allow-sensitive",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/.env"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "the explicit --deny entry still holds",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/notes.secret"
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-SEC-004",
      "title": "RE2 refuses backtracking syntax and cannot ReDoS",
      "traceability": "F25",
      "profile": "default",
      "steps": [
        {
          "name": "lookahead is rejected",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "foo(?=bar)",
            "isRegex": true
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "lookbehind is rejected",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "(?<=x)y",
            "isRegex": true
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "backreference is rejected",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "(a)\\1",
            "isRegex": true
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "catastrophic pattern completes in linear time",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}/redos.txt",
            "searchPattern": "(a+)+$",
            "isRegex": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "replace_text rejects the same syntax",
          "method": "tools/call",
          "tool": "replace_text",
          "args": {
            "path": "${FIXTURE}/bulk",
            "searchPattern": "foo(?=bar)",
            "replacement": "x",
            "isRegex": true,
            "dryRun": true
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-SEC-005",
      "title": "HTTP API key, Host and Origin validation, and rate limiting",
      "traceability": "F26",
      "profile": "default",
      "steps": [
        {
          "name": "401 challenge, Host/Origin rejection, 429 flood",
          "skip": "raw HTTP headers and status codes, not MCP methods — belongs to a curl check"
        }
      ]
    }
  ]
}
