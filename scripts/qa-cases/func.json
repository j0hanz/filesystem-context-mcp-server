{
  "cases": [
    {
      "id": "TC-FUNC-001",
      "title": "Root discovery across configuration sources",
      "traceability": "F1",
      "profile": "default",
      "steps": [
        {
          "name": "list_roots reports the positional root",
          "method": "tools/call",
          "tool": "list_roots",
          "args": {},
          "expect": {
            "isError": false,
            "has": ["structuredContent.roots"]
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-001b",
      "title": "Root discovery via FS_ALLOWED_DIRS",
      "traceability": "F1",
      "profile": "envroots",
      "steps": [
        {
          "name": "list_roots reports the environment root",
          "method": "tools/call",
          "tool": "list_roots",
          "args": {},
          "expect": {
            "isError": false,
            "has": ["structuredContent.roots"]
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-002",
      "title": "list tree, depth, and hidden/ignored filters",
      "traceability": "F2",
      "profile": "default",
      "steps": [
        {
          "name": "list at default depth",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}"
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.entries"]
          }
        },
        {
          "name": "recurse to depth 3",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}",
            "maxDepth": 3
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "include hidden entries",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}",
            "includeHidden": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "listing a file is rejected",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}/src/app.ts"
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-003",
      "title": "find_files glob matching, sort, and depth",
      "traceability": "F3",
      "profile": "default",
      "steps": [
        {
          "name": "recursive typescript glob",
          "method": "tools/call",
          "tool": "find_files",
          "args": {
            "path": "${FIXTURE}",
            "pattern": "**/*.ts"
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.results"]
          }
        },
        {
          "name": "sort by basename",
          "method": "tools/call",
          "tool": "find_files",
          "args": {
            "path": "${FIXTURE}",
            "pattern": "**/*.ts",
            "sortBy": "name"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "no match returns an empty set, not an error",
          "method": "tools/call",
          "tool": "find_files",
          "args": {
            "path": "${FIXTURE}",
            "pattern": "**/*.zzz"
          },
          "expect": {
            "isError": false
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-004",
      "title": "stat metadata, single and batch",
      "traceability": "F4",
      "profile": "default",
      "steps": [
        {
          "name": "single path",
          "method": "tools/call",
          "tool": "stat",
          "args": {
            "path": "${FIXTURE}/src/ten.txt"
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.results"]
          }
        },
        {
          "name": "batch with one missing path",
          "method": "tools/call",
          "tool": "stat",
          "args": {
            "paths": ["${FIXTURE}/src/app.ts", "${FIXTURE}/nope.txt"]
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.results"]
          }
        },
        {
          "name": "path and paths together are rejected",
          "method": "tools/call",
          "tool": "stat",
          "args": {
            "path": "${FIXTURE}/src/app.ts",
            "paths": ["${FIXTURE}/src/ten.txt"]
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-005",
      "title": "search_text literal, regex, case, and glob scoping",
      "traceability": "F5",
      "profile": "default",
      "steps": [
        {
          "name": "literal search",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "TODO"
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.matches"]
          }
        },
        {
          "name": "case-insensitive by default",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "todo"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "case-sensitive finds nothing",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "todo",
            "caseSensitive": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "RE2 regex with a capture group",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "const\\s+(\\w+)",
            "isRegex": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "whitespace-only pattern is rejected",
          "method": "tools/call",
          "tool": "search_text",
          "args": {
            "path": "${FIXTURE}",
            "searchPattern": "   "
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-006",
      "title": "diff then patch round trip with dry run",
      "traceability": "F6",
      "profile": "default",
      "steps": [
        {
          "name": "diff the two fixture files",
          "method": "tools/call",
          "tool": "diff",
          "args": {
            "a": "${FIXTURE}/src/app.copy.ts",
            "b": "${FIXTURE}/src/app.ts"
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.linesAdded"]
          }
        },
        {
          "name": "apply that diff as a dry run",
          "method": "tools/call",
          "tool": "patch",
          "args": {
            "path": "${FIXTURE}/src/app.copy.ts",
            "diff": "${steps[0].content.0.text}",
            "dryRun": true
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.diff"]
          }
        },
        {
          "name": "apply the diff for real",
          "method": "tools/call",
          "tool": "patch",
          "args": {
            "path": "${FIXTURE}/src/app.copy.ts",
            "diff": "${steps[0].content.0.text}"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "re-applying the same diff is refused",
          "method": "tools/call",
          "tool": "patch",
          "args": {
            "path": "${FIXTURE}/src/app.copy.ts",
            "diff": "${steps[0].content.0.text}"
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-007",
      "title": "read line ranges, batch, hash, and media",
      "traceability": "F7",
      "profile": "default",
      "steps": [
        {
          "name": "full read",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt"
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.results"]
          }
        },
        {
          "name": "head 3",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt",
            "head": 3
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "tail 2",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt",
            "tail": 2
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "line range 4-6",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt",
            "startLine": 4,
            "endLine": 6
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "head and tail together are rejected",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt",
            "head": 3,
            "tail": 2
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "batch read keeps input order",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "paths": ["${FIXTURE}/src/ten.txt", "${FIXTURE}/src/app.ts"]
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "sha-256 of the returned content",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt",
            "includeHash": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "image read returns a media block",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/pic.png"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "truncated read emits a continuation",
          "skip": "needs a multi-megabyte fixture; the response would dominate the transcript"
        }
      ]
    },
    {
      "id": "TC-FUNC-008",
      "title": "create and edit, including dry-run preview",
      "traceability": "F8",
      "profile": "default",
      "steps": [
        {
          "name": "create a file under a new parent directory",
          "method": "tools/call",
          "tool": "create",
          "args": {
            "files": [
              {
                "path": "${FIXTURE}/new/dir/a.txt",
                "content": "hello\n"
              }
            ]
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.files"]
          }
        },
        {
          "name": "create over an existing file",
          "method": "tools/call",
          "tool": "create",
          "args": {
            "files": [
              {
                "path": "${FIXTURE}/new/dir/a.txt",
                "content": "replaced\n"
              }
            ]
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "edit as a dry run",
          "method": "tools/call",
          "tool": "edit",
          "args": {
            "path": "${FIXTURE}/src/app.ts",
            "edits": [
              {
                "oldText": "const a = 1;",
                "newText": "const a = 42;"
              }
            ],
            "dryRun": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "apply the edit",
          "method": "tools/call",
          "tool": "edit",
          "args": {
            "path": "${FIXTURE}/src/app.ts",
            "edits": [
              {
                "oldText": "const a = 1;",
                "newText": "const a = 42;"
              }
            ]
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "unmatched oldText is refused",
          "method": "tools/call",
          "tool": "edit",
          "args": {
            "path": "${FIXTURE}/src/app.ts",
            "edits": [
              {
                "oldText": "const zzz = 0;",
                "newText": "x"
              }
            ]
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "path and files together are rejected",
          "method": "tools/call",
          "tool": "edit",
          "args": {
            "path": "${FIXTURE}/src/app.ts",
            "edits": [
              {
                "oldText": "a",
                "newText": "b"
              }
            ],
            "files": [
              {
                "path": "${FIXTURE}/src/ten.txt",
                "edits": [
                  {
                    "oldText": "a",
                    "newText": "b"
                  }
                ]
              }
            ]
          },
          "expect": {
            "isError": true
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-009",
      "title": "move, copy, and delete",
      "traceability": "F9",
      "profile": "default",
      "steps": [
        {
          "name": "rename a file",
          "method": "tools/call",
          "tool": "move",
          "args": {
            "moves": [
              {
                "source": "${FIXTURE}/del/a.txt",
                "destination": "${FIXTURE}/del/g.txt"
              }
            ]
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.moves"]
          }
        },
        {
          "name": "copy leaves the source in place",
          "method": "tools/call",
          "tool": "move",
          "args": {
            "moves": [
              {
                "source": "${FIXTURE}/del/g.txt",
                "destination": "${FIXTURE}/del/h.txt"
              }
            ],
            "copy": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "destination outside the root is denied",
          "method": "tools/call",
          "tool": "move",
          "args": {
            "moves": [
              {
                "source": "${FIXTURE}/del/g.txt",
                "destination": "${FIXTURE}/../stolen.txt"
              }
            ]
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "delete a file after confirmation",
          "skip": "E7 — delete raises an input_required round; the Inspector CLI cannot answer it"
        },
        {
          "name": "delete a non-empty directory without recursive",
          "skip": "E7 — same confirmation round"
        }
      ]
    },
    {
      "id": "TC-FUNC-010",
      "title": "replace_text dry run first, then scoped apply",
      "traceability": "F10",
      "profile": "default",
      "steps": [
        {
          "name": "dry run scoped by path and glob",
          "method": "tools/call",
          "tool": "replace_text",
          "args": {
            "path": "${FIXTURE}/bulk",
            "pattern": "**/*.txt",
            "searchPattern": "foo",
            "replacement": "baz",
            "dryRun": true,
            "returnDiff": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "whole-word matching excludes foobar",
          "method": "tools/call",
          "tool": "replace_text",
          "args": {
            "path": "${FIXTURE}/bulk",
            "searchPattern": "foo",
            "replacement": "baz",
            "wholeWord": true,
            "dryRun": true
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "apply for real",
          "method": "tools/call",
          "tool": "replace_text",
          "args": {
            "path": "${FIXTURE}/bulk",
            "pattern": "**/*.txt",
            "searchPattern": "foo",
            "replacement": "baz"
          },
          "expect": {
            "isError": false
          }
        },
        {
          "name": "regex capture-group reference",
          "method": "tools/call",
          "tool": "replace_text",
          "args": {
            "path": "${FIXTURE}/bulk",
            "searchPattern": "(baz)",
            "replacement": "$1_renamed",
            "isRegex": true,
            "dryRun": true
          },
          "expect": {
            "isError": false
          }
        }
      ]
    },
    {
      "id": "TC-FUNC-011",
      "title": "Batch partial failure reporting",
      "traceability": "F11",
      "profile": "default",
      "steps": [
        {
          "name": "batch read with one denied path",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "paths": ["${FIXTURE}/src/app.ts", "${FIXTURE}/.env"]
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.results"]
          }
        },
        {
          "name": "batch create with one out-of-root destination",
          "method": "tools/call",
          "tool": "create",
          "args": {
            "files": [
              {
                "path": "${FIXTURE}/new/ok.txt",
                "content": "ok\n"
              },
              {
                "path": "${FIXTURE}/../escaped.txt",
                "content": "no\n"
              }
            ]
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "batch delete where the user skips one path",
          "skip": "E7 — the skip answer is an input_required round the CLI cannot answer"
        }
      ]
    },
    {
      "id": "TC-FUNC-012",
      "title": "Pagination cursor continuity and snapshot expiry",
      "traceability": "F12",
      "profile": "default",
      "steps": [
        {
          "name": "first page",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}/page",
            "maxEntries": 2
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.nextCursor"]
          }
        },
        {
          "name": "second page via cursor",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}/page",
            "maxEntries": 2,
            "cursor": "${steps[0].structuredContent.nextCursor}"
          },
          "expect": {
            "isError": false,
            "has": ["structuredContent.entries"]
          }
        },
        {
          "name": "malformed cursor is rejected",
          "method": "tools/call",
          "tool": "list",
          "args": {
            "path": "${FIXTURE}/page",
            "maxEntries": 2,
            "cursor": "not-a-cursor"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "expired cursor after the snapshot TTL",
          "skip": "would add ~60s of wall clock to every pass; run by hand when cursor TTL is in question"
        }
      ]
    },
    {
      "id": "TC-FUNC-013",
      "title": "get-help prompt topics and argument completion",
      "traceability": "F13",
      "profile": "default",
      "steps": [
        {
          "name": "prompts/list",
          "method": "prompts/list",
          "expect": {
            "has": ["prompts"]
          }
        },
        {
          "name": "full instructions with no topic",
          "method": "prompts/get",
          "prompt": "get-help",
          "expect": {
            "has": ["messages"]
          }
        },
        {
          "name": "filtered to the constraints section",
          "method": "prompts/get",
          "prompt": "get-help",
          "promptArgs": {
            "topic": "constraints"
          },
          "expect": {
            "has": ["messages"]
          }
        },
        {
          "name": "unknown topic falls back informatively",
          "method": "prompts/get",
          "prompt": "get-help",
          "promptArgs": {
            "topic": "nope"
          },
          "expect": {
            "has": ["messages"]
          }
        },
        {
          "name": "topic argument completion",
          "skip": "E8 — the Inspector CLI exposes no completion/complete method"
        }
      ]
    },
    {
      "id": "TC-FUNC-014",
      "title": "--print-config reports the resolved runtime configuration",
      "traceability": "F14",
      "profile": "default",
      "steps": [
        {
          "name": "print config as JSON",
          "skip": "server CLI flag, not an MCP method — belongs to a shell check, not this runner"
        }
      ]
    },
    {
      "id": "TC-FUNC-015",
      "title": "Error taxonomy and recovery guidance",
      "traceability": "F15",
      "profile": "default",
      "steps": [
        {
          "name": "ACCESS_DENIED via traversal",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/../etc/hosts"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "NOT_FOUND on a missing file",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/missing.txt"
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "INVALID_INPUT from mutually exclusive arguments",
          "method": "tools/call",
          "tool": "read",
          "args": {
            "path": "${FIXTURE}/src/ten.txt",
            "paths": ["${FIXTURE}/src/app.ts"]
          },
          "expect": {
            "isError": true
          }
        },
        {
          "name": "unknown tool name",
          "method": "tools/call",
          "tool": "nosuchtool",
          "args": {},
          "expect": {
            "cliErrorCode": "tool_not_found"
          }
        }
      ]
    }
  ]
}
