{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.j0hanz/filesystem-mcp",
  "title": "Filesystem MCP",
  "description": "Secure filesystem MCP server for reading, writing, searching, diffing, and patching files.",
  "websiteUrl": "https://github.com/j0hanz/filesystem-mcp",
  "repository": {
    "url": "https://github.com/j0hanz/filesystem-mcp",
    "source": "github",
    "id": "1115057681"
  },
  "version": "1.19.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@j0hanz/filesystem-mcp",
      "version": "1.19.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "allowed_directory",
          "description": "Directory path the server is allowed to access. Repeat for multiple directories.",
          "format": "filepath",
          "isRequired": false,
          "isRepeated": true
        },
        {
          "type": "named",
          "name": "--allow-cwd",
          "description": "Allow the current working directory as an additional access root.",
          "format": "boolean",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "oci",
      "identifier": "ghcr.io/j0hanz/filesystem-mcp:1.19.1",
      "runtimeHint": "docker",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
