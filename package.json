{
  "name": "@j0hanz/filesystem-mcp",
  "version": "1.19.1",
  "mcpName": "io.github.j0hanz/filesystem-mcp",
  "description": "Secure filesystem MCP server for reading, writing, searching, diffing, and patching files.",
  "author": "j0hanz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/j0hanz/filesystem-mcp.git"
  },
  "homepage": "https://github.com/j0hanz/filesystem-mcp#readme",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "filesystem-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "knip": "knip",
    "check:static": "npm run build && npm run type-check && eslint . && prettier --check . && knip",
    "check": "npm run check:static && npm run test",
    "test": "node --test --import tsx/esm \"__tests__/**/*.test.ts\"",
    "inspector": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js ${workspaceFolder}",
    "tasks": "node scripts/tasks.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "filesystem",
    "file-management",
    "file-operations",
    "grep",
    "glob",
    "diff",
    "patch",
    "search",
    "security",
    "server",
    "stdio",
    "typescript",
    "nodejs",
    "llm",
    "cli"
  ],
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/client": "2.0.0-alpha.2",
    "@modelcontextprotocol/express": "2.0.0-alpha.2",
    "@modelcontextprotocol/node": "2.0.0-alpha.2",
    "@modelcontextprotocol/server": "2.0.0-alpha.2",
    "diff": "^9",
    "express": "^5.2.1",
    "ignore": "^7.0.5",
    "re2": "^1.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.12.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "engines": {
    "node": ">=24"
  }
}
